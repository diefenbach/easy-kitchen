FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app
RUN addgroup --system app && adduser --system --ingroup app app
RUN pip install --no-cache-dir uv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev
COPY src /app/src
RUN DJANGO_SETTINGS_MODULE=project.settings.build python src/manage.py collectstatic --noinput
RUN mkdir -p /app/src/staticfiles /app/src/media \
    && chown -R app:app /app

WORKDIR /app/src
USER app

EXPOSE 8080
CMD ["sh", "-c", "exec gunicorn project.wsgi:application --bind 0.0.0.0:${PORT:-8080} --workers ${GUNICORN_WORKERS:-2}"]
